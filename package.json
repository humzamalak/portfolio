{
  "name": "humza-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPatterns=email-utils.test.ts",
    "test:component": "jest --testPathPatterns=ContactSection.test.tsx",
    "test:api": "jest --testPathPatterns=contact-api.test.ts",
    "test:integration": "jest --testPathPatterns=contact-integration.test.tsx",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "test:all": "npm run test:unit && npm run test:component && npm run test:api && npm run test:integration",
    "test:medium": "jest --testPathPatterns=medium-integration.test.ts",
    "netlify:dev": "npx netlify-cli@latest dev",
    "netlify:login": "npx netlify-cli@latest login",
    "netlify:deploy": "npx netlify-cli@latest deploy --build --prod"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.27.0",
    "next": "^16.2.12",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "resend": "^6.18.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/chart.js": "^2.9.41",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.4",
    "cypress": "^15.19.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "^8.5.24",
    "sharp": "^0.35.3",
    "brace-expansion": "^5.0.8",
    "minimatch": "^10.2.6",
    "glob": "^13.0.6",
    "babel-plugin-istanbul": "^8.0.0",
    "test-exclude": "^8.0.0"
  }
}
